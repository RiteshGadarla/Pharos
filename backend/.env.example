# Copy to .env and fill in. Never commit the real .env.

# Demo mode: offline serves precomputed artifacts only, no network calls.
DEMO_MODE=offline

# Postgres / PostGIS / TimescaleDB
# Runs in Docker (make up); everything else runs locally, so this is
# the host-published port, not the in-network service name.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=drishta
POSTGRES_USER=drishta
POSTGRES_PASSWORD=changeme

# NASA Earthdata (ASF, Sentinel-1)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Copernicus Marine (ocean currents)
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# Copernicus Climate Data Store (ERA5 wind)
# Prefer ~/.cdsapirc for the API key, this is a fallback.
CDS_API_KEY=

# Kaggle (real oil-spill SAR texture patches, composited into the
# synthetic fixture scene since the gated five-class dataset isn't
# obtainable in time, see PLAN.md section 4A)
KAGGLE_API_TOKEN=

# Cerulean (SkyTruth) public read API, VALIDATION ONLY.
#
# The tipg service at api.cerulean.skytruth.org does not require the
# Bearer key the other cerulean-cloud services need, so this is normally
# left blank. It is listed here only so that nobody hardcodes a key if
# one ever becomes necessary.
#
# Non-negotiable 5: Cerulean is never in the runtime path. It is used by
# backend/validation/ only, and backend/tests/test_no_cerulean_in_services.py
# enforces that by scanning the source tree. Every response is cached to
# backend/data/cerulean/, so the harness runs offline after the first fetch.
CERULEAN_API_KEY=

# Deterministic seeds, mirrored into config/pipeline.yaml and config/demo.yaml
GLOBAL_SEED=26143
