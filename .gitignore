__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/

# data, keep placeholders and fixtures only
backend/data/models/*
!backend/data/models/.gitkeep
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/interim/*
!backend/data/interim/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/precomputed/*
!backend/data/precomputed/.gitkeep
!backend/data/precomputed/hero_sequence.json
# Cached Cerulean validation pulls. Regeneratable from the public read
# API, and validation-only (PLAN.md non-negotiable 5).
backend/data/cerulean/*
!backend/data/cerulean/.gitkeep

# regeneratable fixture data (NetCDF, GeoTIFF): `make synthetic` rebuilds
# these from backend/scripts/make_synthetic_data.py, no need to commit them.
# The real oil-texture PNGs stay committed (real_oil_texture/, not
# scripted, see its ATTRIBUTION.md).
backend/data/fixtures/*.nc
backend/data/fixtures/*.tif
# The one exception, and it is deliberate: synthetic_scene.tif is the
# staged sample image, committed so that a fresh clone has a SAR scene to
# process without generating anything first. 0.9MB once, against a setup
# step every new contributor would otherwise have to get right before
# seeing the system do anything. See backend/data/fixtures/SAMPLE_SCENE.md.
!backend/data/fixtures/synthetic_scene.tif

.env
*.log
.DS_Store
.pytest_cache/
.mypy_cache/
.ruff_cache/

# P-1 deck figures: regenerated by deck/scripts/make_figures.py from the
# precomputed demo bundle, so no reason to carry binary diffs in history.
deck/figures/*.png
/personal
# SIH portal submission text (idea title, description, abstract). Drafted
# from the docs and pasted into the portal, not part of the build.
/submission
.vscode/