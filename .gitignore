__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/

# data, keep placeholders and fixtures only
backend/data/models/*
!backend/data/models/.gitkeep
backend/data/raw/*
!backend/data/raw/.gitkeep
backend/data/interim/*
!backend/data/interim/.gitkeep
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/precomputed/*
!backend/data/precomputed/.gitkeep
!backend/data/precomputed/hero_sequence.json
# Cached Cerulean validation pulls. Regeneratable from the public read
# API, and validation-only (PLAN.md non-negotiable 5).
backend/data/cerulean/*
!backend/data/cerulean/.gitkeep

# regeneratable fixture data (NetCDF, GeoTIFF): `make fixtures` rebuilds
# these from backend/scripts/make_fixture_*.py, no need to commit them.
# The real oil-texture PNGs stay committed (real_oil_texture/, not
# scripted, see its ATTRIBUTION.md).
backend/data/fixtures/*.nc
backend/data/fixtures/*.tif

.env
*.log
.DS_Store
.pytest_cache/
.mypy_cache/
.ruff_cache/

# P-1 deck figures: regenerated by deck/scripts/make_figures.py from the
# precomputed demo bundle, so no reason to carry binary diffs in history.
deck/figures/*.png
